# /filming media stack. Leave DATABASE_URL unset to use the bundled placeholders.
DATABASE_URL=postgres://javidan:javidan@localhost:5434/javidan

# MinIO (S3 API). On Hetzner point these at the MinIO server.
S3_ENDPOINT=http://localhost:9006
S3_REGION=us-east-1
S3_ACCESS_KEY=javidan
S3_SECRET_KEY=javidan-dev-secret
S3_BUCKET=media

# Public base URL objects are served from (bucket included).
MEDIA_PUBLIC_URL=http://localhost:9006/media
